# Plantilla de variables de entorno. Copiar a .env y rellenar:  cp .env.example .env
# Las leen docker compose y el backend (mvnw spring-boot:run).

# MySQL
DB_NAME=sindinails_db
DB_USERNAME=user
DB_PASSWORD=password
DB_ROOT_PASSWORD=root_password
DB_PORT=3307

# JWT (secreto en Base64, mínimo 32 bytes). OBLIGATORIO: genera uno con  openssl rand -base64 32
# y pégalo aquí. Si se queda vacío, docker compose no arranca.
JWT_SECRET_KEY=
JWT_EXPIRATION=86400000

# CORS: orígenes que pueden llamar a la API, separados por comas (sin barra final)
CORS_ALLOWED_ORIGINS=http://localhost:5173
