{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/**/*.{js,jsx}",
    "!src/**/*.test.{js,jsx}",
    "!src/test/**",
    "!src/components/ui/**"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "concurrency": 2
}
